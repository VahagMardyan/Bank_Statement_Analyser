classDiagram
    direction LR

    class AnalyticsService {
        - AnomalyDetector _anomaly_detector
        + expenses(df)$ DataFrame
        + compute_kpis(df) KPIMetrics
        + category_summary(df) DataFrame
        + monthly_trends(df, freq) DataFrame
        + weekly_trends(df) DataFrame
        + top_expenses(df, n) DataFrame
        + detect_anomalies(df, threshold_std, detector) DataFrame
        + check_budget_limits(df, budget_dict) DataFrame
    }

    class AnomalyDetector {
        <<abstract>>
        + detect(expenses)* DataFrame
    }
    class ZScoreAnomalyDetector {
        + float threshold_std
        + detect(expenses) DataFrame
    }

    class KPIMetrics {
        <<dataclass>>
        + float total_income
        + float total_expenses
        + float net_savings
        + int transaction_count
        + empty()$ KPIMetrics
        + as_dict() dict
    }

    class ExportStrategy {
        <<abstract>>
        + str file_extension
        + str mime_type
        + export(df, columns) bytes
        # _serialize(df)* bytes
    }
    class CsvExportStrategy {
        # _serialize(df) bytes
    }
    class ExcelExportStrategy {
        # _serialize(df) bytes
    }
    class ExportStrategyFactory {
        - dict _registry$
        + register(label)$ decorator
        + labels()$ list
        + create(label)$ ExportStrategy
    }

    AnomalyDetector <|-- ZScoreAnomalyDetector : Strategy
    AnalyticsService o-- AnomalyDetector : injected (optional)
    AnalyticsService ..> KPIMetrics : returns

    ExportStrategy <|-- CsvExportStrategy : Strategy + Template Method
    ExportStrategy <|-- ExcelExportStrategy : Strategy + Template Method
    ExportStrategyFactory o-- ExportStrategy : @register (Registry)
    ExportStrategyFactory ..> ExportStrategy : creates
